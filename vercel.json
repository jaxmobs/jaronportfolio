{
  "rewrites": [
    { "source": "/blog/:id", "destination": "/blog/:id.html" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "comment": "Font files are content-stable — a different cut would land under a different name.",
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "comment": "Photographs are cached hard but stay revalidatable: optimize-blog rewrites files in place under the same name, so 'immutable' would strand a replaced image in browsers for a year.",
      "source": "/(gallery|blog)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/hero-video.mp4",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/og-image.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
